# Names only. Real values go in .env.local (git-ignored) or the Convex dashboard. Never commit values.

# Desktop main process: Auth0 Native application (public identifiers, built into the app; also set both on Convex)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Convex (written by `convex dev`)
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Convex server environment (set in the Convex dashboard, not in the desktop app)
TOKEN_ENCRYPTION_KEY=
# Composio (Slack, Gmail, Outlook mail, Teams, GitHub): project API key, webhook signing secret, one auth config per toolkit
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_AUTH_CONFIG_SLACK=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_TEAMS=
COMPOSIO_AUTH_CONFIG_GITHUB=
# Telegram (TARS on Telegram): the bot's token from @BotFather, its @username without the @, and a random secret
# Telegram sends back in a header on every webhook call. After setting them: pnpm exec convex run telegram:register
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=
