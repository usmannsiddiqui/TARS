{
  "name": "companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "build": "pnpm --filter @companion/desktop build",
    "package:mac": "pnpm --filter @companion/desktop package:mac",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "convex": "^1.50.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@companion/domain": "workspace:^",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "convex-test": "^0.0.71",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
